{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "composite": true,
    "declaration": true,
    "outDir": "./dist/cjs",
    "rootDir": "./src",
    "strict": true,
    "tsBuildInfoFile": "./dist/cjs/.tsbuildinfo",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
